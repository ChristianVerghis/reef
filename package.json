{
  "name": "reef",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first AI cockpit for orchestrating coding agents across many repos",
  "bin": {
    "reef": "./packages/cli/bin.js"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm -r --filter=./packages/* build",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "lint": "pnpm -r --filter=./packages/* lint",
    "reef": "node packages/cli/bin.js",
    "test": "pnpm -r --filter=./packages/* --if-present test"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@8.6.9",
  "engines": {
    "node": ">=20"
  }
}
